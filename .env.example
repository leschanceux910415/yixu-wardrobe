# Copy to .env locally. Never put a real key in browser code or Git.
MODEL_API_KEY=
# Include the API version or compatible-mode path supplied by your provider.
# Example OpenAI endpoint: https://api.openai.com/v1
MODEL_BASE_URL=
TEXT_MODEL=
VISION_MODEL=
PORT=5173
HOST=127.0.0.1
MODEL_TIMEOUT_MS=12000
MODEL_MAX_CALLS_PER_DAY=100
MODEL_JSON_MODE=true
# DeepSeek official endpoint defaults to non-thinking mode for short JSON tasks.
# Leave blank for other providers unless they support this parameter.
MODEL_THINKING=
MODEL_MAX_TOKENS=1600
# Optional cost rates from your provider, in RMB per one million tokens.
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=
# Public deployment keeps AI calls disabled unless a shared rate limit is configured.
PUBLIC_DEPLOYMENT=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
